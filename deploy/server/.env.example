# Server side of the Home Assistant Green layout (docs/setup-green.md)

# Absolute path to your music library on this machine
MUSIC_DIR=/srv/music
# Owner of the music files (Navidrome runs as this user)
PUID=1000
PGID=1000

# Speech for Assist on the Green
WHISPER_MODEL=small-int8
VOICE_LANGUAGE=en
PIPER_VOICE=en_US-lessac-medium

# Clean library (optional, docs/clean-library.md)
# Parent folder that contains your music folder; the clean copy is created next to it.
MEDIA_ROOT=/srv
MUSIC_SUBDIR=music
CLEAN_SUBDIR=music-clean
# Serve the clean copy from Navidrome instead of the originals:
# NAVIDROME_MUSIC_DIR=/srv/music-clean
CLEANER_WHISPER_MODEL=small
CLEANER_INTERVAL=21600
# Optional: lyrics from Genius for songs without .lrc/embedded lyrics (free token: genius.com/api-clients)
GENIUS_ACCESS_TOKEN=
# NVIDIA GPU build for the cleaner:
# CLEANER_TORCH_INDEX=https://download.pytorch.org/whl/cu124
