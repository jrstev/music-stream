# Absolute path to your music library on the host
MUSIC_DIR=/srv/music
# Owner of the music files (navidrome runs as this user)
PUID=1000
PGID=1000
TZ=America/New_York

# Voice (Assist)
WHISPER_MODEL=small-int8
VOICE_LANGUAGE=en
PIPER_VOICE=en_US-lessac-medium

# Clean library (optional, docs/clean-library.md)
# Parent folder that contains your music folder; the clean copy is created next to it.
MEDIA_ROOT=/srv
MUSIC_SUBDIR=music
CLEAN_SUBDIR=music-clean
# Point Navidrome at the clean copy instead of the originals:
# NAVIDROME_MUSIC_DIR=/srv/music-clean
CLEANER_WHISPER_MODEL=small
CLEANER_INTERVAL=21600
# Optional: fetch lyrics from Genius for songs without .lrc/embedded lyrics (free token from genius.com/api-clients)
GENIUS_ACCESS_TOKEN=
# GPU build: CLEANER_TORCH_INDEX=https://download.pytorch.org/whl/cu124
